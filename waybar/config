{
  // ============================================================
  // Waybar 主配置（精简现网布局）
  // 样式：style.css 为当前生效样式（由 styles/dark.css 或 light.css 复制）
  // 仅保留 dark / light 两套；模块定义见 modules.jsonc
  // ============================================================

  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "spacing": 3,
  "fixed-center": true,
  "ipc": true,
  "margin-left": 10,
  "margin-right": 10,

  // 左侧：系统监控
  "modules-left": [
    "cpu",
    "memory",
    "temperature"
  ],

  // 中间：菜单 / 工作区 / 窗口标题
  "modules-center": [
    "custom/menu",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  // 右侧：托盘 / 亮度 / 音量 / 电池 / 时钟（时钟靠最右）
  "modules-right": [
    "tray",
    "backlight",
    "pulseaudio",
    "battery",
    "clock"
  ]
}
