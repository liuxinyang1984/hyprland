# ============================================================
# 办公室台式机 env.conf 示例（整文件替换 hypr/env.conf）
# 实机：DP-1 主屏 + DVI-D-1 竖屏；scale 1.0
# ============================================================

# --- DPI ---
# exec-once = echo "Xft.dpi: 96" | xrdb -merge

# --- 本机显示器 ---
# monitor = DP-1, 1920x1200, 0x0, 1
# monitor = DVI-D-1, 1600x1200, 1940x0, 1, transform, 1
# monitor = , preferred, auto, 1

# --- 可选：主屏 1–5 / 副屏 6–10 ---
# workspace = 1, monitor:DP-1
# workspace = 2, monitor:DP-1
# workspace = 3, monitor:DP-1
# workspace = 4, monitor:DP-1
# workspace = 5, monitor:DP-1
# workspace = 6, monitor:DVI-D-1
# workspace = 7, monitor:DVI-D-1
# workspace = 8, monitor:DVI-D-1
# workspace = 9, monitor:DVI-D-1
# workspace = 10, monitor:DVI-D-1
