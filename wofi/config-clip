## Wofi：剪贴板历史（cliphist + dmenu）
## 样式与应用启动器共用 style.css（dark/light）

## General
show=dmenu
prompt=剪贴板
normal_window=false
layer=overlay
term=foot
columns=1

## Geometry
width=42%
height=48%
location=center
orientation=vertical
halign=fill
line_wrap=off
dynamic_lines=false

## Images
allow_markup=true
allow_images=false
image_size=24

## Search
exec_search=false
hide_search=false
parse_search=false
insensitive=true

## Other
hide_scroll=false
no_actions=true
sort_order=default
gtk_dark=true
filter_rate=100

## Keys
key_expand=Tab
key_exit=Escape
